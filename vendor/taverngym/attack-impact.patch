+/// Record the immediate result before deferred damage triggers or death processing.
+fn contact_damage(
+    ctx: &mut Ctx,
+    source: EntityId,
+    target: EntityId,
+    amount: i32,
+    impact: &mut Option<crate::engine::AttackImpact>,
+) -> i32 {
+    let shield = impact
+        .as_ref()
+        .and_then(|_| ctx.minion(target))
+        .map(|m| m.shield_hits);
+    let damage = ctx.damage(source, target, amount);
+    if let (Some(impact), Some(shield), Some(m)) = (impact, shield, ctx.minion(target)) {
+        impact.hits.push(crate::engine::ContactHit {
+            target,
+            damage,
+            hp: m.hp,
+            shield_hits: m.shield_hits,
+            absorbed: m.shield_hits < shield,
+            lethal: !m.alive(),
+        });
+    }
+    damage
+}
