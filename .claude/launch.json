{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["BG_SAVE_PATH=work/server/games.sqlite3", "BG_STATIC_DIR=frontend/dist", ".venv/bin/python", "-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8002"],
      "port": 8002
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "frontend"],
      "port": 5173
    }
  ]
}
